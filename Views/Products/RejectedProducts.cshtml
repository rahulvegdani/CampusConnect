@model IEnumerable<CampusConnect.Models.Product>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Rejected Products";
}

<style>
    .product-card {
        background: white;
        border-radius: 15px;
        padding: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        transition: 0.3s;
    }

        .product-card:hover {
            transform: translateY(-5px);
        }

    .product-img {
        width: 100%;
        height: 150px;
        object-fit: cover;
        border-radius: 10px;
    }

    .product-title {
        font-weight: 600;
        font-size: 18px;
    }

    .product-price {
        color: #dc2626;
        font-weight: bold;
    }

    .badge-category {
        background: #fee2e2;
        color: #b91c1c;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
    }

    .empty-box {
        text-align: center;
        margin-top: 50px;
        color: gray;
    }
</style>

<div class="container-fluid mt-4">

    <h2 class="mb-4 fw-bold">❌ Rejected Products</h2>

    <div class="row g-4">

        @if (!Model.Any())
        {
            <div class="empty-box">
                <h4>No rejected products</h4>
                <p>Everything looks clean ✅</p>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4">

                    <div class="product-card">

                        <!-- IMAGE -->
                        <img src="@(item.ImagePath ?? "/images/no-image.png")"
                             class="product-img"
                             onerror="this.src='/images/no-image.png'" />

                        <!-- DETAILS -->
                        <div class="mt-3">

                            <div class="product-title">@item.Name</div>

                            <div class="text-muted" style="font-size:14px;">
                                @item.Description
                            </div>

                            <div class="mt-2 product-price">
                                ₹@item.Price
                            </div>

                            <div class="mt-2">
                                <span class="badge-category">
                                    @item.Category?.Name
                                </span>
                            </div>

                            <div class="mt-2 text-muted" style="font-size:13px;">
                                👤 @item.User?.Email
                            </div>

                        </div>

                        <!-- ACTION -->
                        <div class="mt-3">

                            <a asp-action="Approve"
                                   asp-route-id="@item.Id"
                                   class="btn btn-success btn-sm w-100">
                                🔄 Re-Approve Product
                            </a>

                        </div>

                    </div>

                </div>
            }
        }

    </div>

</div>