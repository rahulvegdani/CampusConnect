@model IEnumerable<CampusConnect.Models.Product>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Pending Products";
}

<style>
    .product-card {
        background: white;
        border-radius: 15px;
        padding: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        transition: 0.3s;
    }

        .product-card:hover {
            transform: translateY(-5px);
        }

    .product-img {
        width: 100%;
        height: 150px;
        object-fit: cover;
        border-radius: 10px;
    }

    .product-title {
        font-weight: 600;
        font-size: 18px;
    }

    .product-price {
        color: #16a34a;
        font-weight: bold;
    }

    .badge-category {
        background: #e0f2fe;
        color: #0369a1;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
    }

    .empty-box {
        text-align: center;
        margin-top: 50px;
        color: gray;
    }
</style>

<div class="container-fluid mt-4">

    <h2 class="mb-4 fw-bold">⏳ Pending Products</h2>

    <div class="row g-4">

        @if (!Model.Any())
        {
            <div class="empty-box">
                <h4>No pending products</h4>
                <p>All products are approved ✅</p>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4">

                    <div class="product-card">

                        <!-- IMAGE -->
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@item.ImagePath"
                                 class="product-img"
                                 onerror="this.src='/images/no-image.png'" />
                        }
                        else
                        {
                            <img src="/images/no-image.png" class="product-img" />
                        }

                        <!-- DETAILS -->
                        <div class="mt-3">

                            <div class="product-title">@item.Name</div>

                            <div class="text-muted" style="font-size:14px;">
                                @item.Description
                            </div>

                            <div class="mt-2 product-price">
                                ₹@item.Price
                            </div>

                            <div class="mt-2">
                                <span class="badge-category">
                                    @item.Category?.Name
                                </span>
                            </div>

                            <div class="mt-2 text-muted" style="font-size:13px;">
                                👤 @item.User?.Email
                            </div>

                        </div>

                        <!-- ACTION BUTTONS -->
                        <div class="mt-3 d-flex justify-content-between">

                            <a asp-action="Approve"
                                   asp-route-id="@item.Id"
                                   class="btn btn-success btn-sm w-50 me-2">
                                ✔ Approve
                            </a>

                            <a asp-action="Reject"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm w-50">
                                ✖ Reject
                            </a>

                        </div>

                    </div>

                </div>
            }
        }

    </div>

</div>