@using System.Security.Claims
@inject CampusConnect.Data.ApplicationDbContext _context
@using Microsoft.AspNetCore.Identity
@inject UserManager<CampusConnect.Models.ApplicationUser> UserManager
@inject SignInManager<CampusConnect.Models.ApplicationUser> SignInManager

@{
    var currentUser = await UserManager.GetUserAsync(User);

    if (currentUser != null && currentUser.IsDeleted)
    {
        await SignInManager.SignOutAsync();
        Context.Response.Redirect("/Identity/Account/Login");
    }
}

@{
    var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

    var profileImage = _context.UserProfiles
        .Where(p => p.UserId == userId)
        .Select(p => p.ProfileImagePath)
        .FirstOrDefault();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusConnect</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            body {
                background: #f1f5f9;
                font-family: 'Segoe UI', sans-serif;
            }

            /* NAVBAR */
            .navbar {
                background: linear-gradient(135deg, #2563eb, #1e40af);
                padding: 16px 0;
            }

            .navbar-brand {
                font-size: 22px;
                font-weight: 700;
            }

            /* NAV ITEMS */
            .nav-item {
                margin: 0 10px;
            }

            .nav-link {
                color: rgba(255,255,255,0.95) !important;
                display: flex;
                flex-direction: column;
                align-items: center;
                padding: 6px 12px;
                transition: 0.25s;
            }

                /* 🔥 FIXED SIZE */
                .nav-link span {
                    font-size: 26px;
                }

                .nav-link small {
                    font-size: 13px;
                    font-weight: 500;
                    margin-top: 2px;
                }

                .nav-link:hover {
                    transform: translateY(-3px);
                    color: #fff !important;
                }

            /* PROFILE */
            .nav-profile-img {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                border: 2px solid rgba(255,255,255,0.4);
                object-fit: cover;
            }

            .user-box {
                display: flex;
                flex-direction: column;
                margin-left: 8px;
            }

                .user-box span {
                    font-size: 14px;
                    font-weight: 600;
                    color: white;
                }

                .user-box small {
                    font-size: 11px;
                    color: #c7d2fe;
                }

            /* LOGOUT */
            .btn-logout {
                background: rgba(255,255,255,0.15);
                color: white;
                border-radius: 20px;
                padding: 6px 16px;
                border: none;
            }

                .btn-logout:hover {
                    background: rgba(255,255,255,0.25);
                }

            /* 🔥 FIXED BADGE */
            .notif-badge {
                position: absolute;
                top: -2px;
                right: -4px;
                background: #ef4444;
                color: white;
                font-size: 10px;
                padding: 2px 6px;
                border-radius: 50px;
                min-width: 16px;
                text-align: center;
                line-height: 1;
            }

            /* DROPDOWN */
            .notification-box {
                width: 340px;
                border-radius: 16px;
                overflow: hidden;
                background: white;
                box-shadow: 0 20px 40px rgba(0,0,0,0.12);
            }

            .notification-header {
                padding: 12px;
                font-weight: 600;
                border-bottom: 1px solid #eee;
            }

            .notification-item {
                padding: 14px;
                display: flex;
                justify-content: space-between;
                gap: 10px;
                border-bottom: 1px solid #f1f5f9;
            }

                .notification-item:hover {
                    background: #f8fafc;
                }

            .notification-unread {
                background: #eef2ff;
            }

            .notification-title {
                font-size: 14px;
                font-weight: 600;
            }

            .notification-time {
                font-size: 11px;
                color: #64748b;
            }

            .notification-delete {
                border: none;
                background: transparent;
                color: red;
                cursor: pointer;
            }

            .notification-empty {
                text-align: center;
                padding: 20px;
                color: gray;
            }

            footer {
                background: white;
                padding: 15px;
                margin-top: 40px;
            }
    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow">
            <div class="container">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    CampusConnect
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navBar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navBar">

                    <ul class="navbar-nav me-auto text-center">

                        @if (User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><span>🏠</span><small>Home</small></a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index"><span>🛒</span><small>Marketplace</small></a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="MyProducts"><span>📦</span><small>My Products</small></a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="MyProfile"><span>👤</span><small>My Profile</small></a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Create"><span>➕</span><small>Add Product</small></a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Chat" asp-action="Inbox"><span>💬</span><small>Messages</small></a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Wishlist" asp-action="Index"><span>❤️</span><small>Wishlist</small></a></li>
                        }

                    </ul>

                    <ul class="navbar-nav align-items-center">

                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- 🔔 FIXED -->
                            <li class="nav-item dropdown me-3">
                                <a class="nav-link position-relative d-flex align-items-center justify-content-center"
                                       style="font-size:22px;"
                                       data-bs-toggle="dropdown">
                                    🔔
                                    <span id="notifCount" class="notif-badge">0</span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end notification-box p-0">

                                    <!-- HEADER -->
                                    <li class="notification-header d-flex justify-content-between align-items-center px-3 py-2">
                                        <span>🔔 Notifications</span>
                                        <button id="clearAllBtn" class="btn btn-sm btn-danger">Clear All</button>
                                    </li>

                                    <!-- LIST -->
                                    <div id="notifItems" style="max-height:300px; overflow-y:auto;"></div>

                                </ul>
                            </li>

                            <!-- PROFILE -->
                            <li class="nav-item d-flex align-items-center me-3">
                                <img src="@(string.IsNullOrEmpty(profileImage) ? "/images/default-user.png" : profileImage)"
                                     class="nav-profile-img" />

                                <div class="user-box">
                                    <span>@User.Identity.Name</span>
                                    <small>Active User</small>
                                </div>
                            </li>

                            <!-- LOGOUT -->
                            <li class="nav-item">
                                <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                                    <button class="btn-logout">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a asp-area="Identity" asp-page="/Account/Login"
                                       class="btn btn-outline-light btn-sm rounded-pill px-3">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-area="Identity" asp-page="/Account/Register"
                                       class="btn btn-light btn-sm rounded-pill px-3">
                                    Register
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="text-center text-muted border-top">
        © 2026 - CampusConnect | <a href="mailto:476comsyurahulvegdani@gmail.com"
                                style="color:#2e7d32; font-weight:600; text-decoration:none;">
        📧 Contact Support
    </a>
    | 
        <a asp-controller="Home" asp-action="Privacy">Privacy</a>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- ✅ Bootstrap -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
            document.addEventListener("DOMContentLoaded", function () {

                loadNotifications();

                // 🔥 CLEAR ALL
                document.addEventListener("click", function (e) {
                    if (e.target.id === "clearAllBtn") {

                        if (!confirm("Clear all notifications?")) return;

                        fetch('/Notification/ClearAll', { method: 'POST' })
                            .then(() => {
                                document.getElementById("notifItems").innerHTML =
                                    '<div class="notification-empty">No notifications</div>';

                                document.getElementById("notifCount").innerText = "0";
                            });
                    }
                });

            });

            // 🔥 LOAD NOTIFICATIONS
            function loadNotifications() {
                fetch('/Notification/GetNotifications')
                    .then(res => res.json())
                    .then(data => {

                        const list = document.getElementById("notifItems");
                        const count = document.getElementById("notifCount");

                        list.innerHTML = "";

                        if (data.length === 0) {
                            list.innerHTML = '<div class="notification-empty">No notifications</div>';
                            count.innerText = "0";
                            return;
                        }

                        count.innerText = data.filter(x => !x.isRead).length;

                        data.forEach(n => {
                            list.innerHTML += `
                                <div class="notification-item ${n.isRead ? '' : 'notification-unread'}">
                                    <div>
                                        <div class="notification-title">${n.title}</div>
                                        <div class="notification-time">${new Date(n.createdAt).toLocaleString()}</div>
                                    </div>
                                    <button class="notification-delete" onclick="deleteNotif(${n.id})">✕</button>
                                </div>
                            `;
                        });
                    });
            }

            // 🔥 DELETE SINGLE
            function deleteNotif(id) {
                fetch('/Notification/Delete?id=' + id)
                    .then(() => loadNotifications()); // ✅ NO RELOAD
            }
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>