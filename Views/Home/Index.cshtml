@{
    ViewData["Title"] = "Home";
}

@using System.Security.Claims

<style>
    /* HERO */
    .hero {
        background: linear-gradient(135deg, #eff6ff, #ffffff);
        padding: 80px 20px;
        border-radius: 20px;
    }

        .hero h1 {
            font-size: 52px;
            font-weight: 700;
            color: #1e3a8a;
        }

        .hero p {
            font-size: 18px;
            color: #475569;
        }

    .btn-main {
        border-radius: 30px;
        padding: 10px 25px;
        font-weight: 500;
    }

    .btn-secondary-custom {
        border-radius: 30px;
        padding: 10px 25px;
        font-weight: 500;
        background: white;
        border: 1px solid #cbd5f5;
        color: #1e40af;
    }

        .btn-secondary-custom:hover {
            background: #f1f5f9;
        }

    /* CARDS */
    .feature-card {
        border: none;
        border-radius: 16px;
        padding: 25px;
        transition: all 0.3s ease;
        background: white;
    }

        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
        }

    .feature-icon {
        font-size: 28px;
        margin-bottom: 10px;
    }
</style>

<div class="container mt-5">

    <!-- HERO SECTION -->
    <div class="hero text-center mb-5">

        <h1>CampusConnect</h1>

        <p class="mt-3">
            Buy and sell products inside your college campus easily.
        </p>

        <div class="mt-4">

            @if (User.Identity.IsAuthenticated)
            {
                <a class="btn btn-primary btn-main me-2"
                       asp-controller="Products"
                       asp-action="Create">
                    Start Selling
                </a>
            }
            else
            {
                <a class="btn btn-primary btn-main me-2"
                       asp-area="Identity"
                       asp-page="/Account/Login">
                    Start Selling
                </a>
            }

            <!-- NEW BUTTON -->
            <a class="btn btn-secondary-custom"
                   asp-controller="Products"
                   asp-action="Index">
                Explore Marketplace
            </a>

        </div>

    </div>

    <!-- FEATURE CARDS -->
    <div class="row text-center g-4">

        <div class="col-md-4">
            <div class="feature-card shadow-sm">
                <div class="feature-icon">📦</div>
                <h5 class="fw-bold">Sell Products</h5>
                <p class="text-muted">Students can post items for sale inside campus.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card shadow-sm">
                <div class="feature-icon">💬</div>
                <h5 class="fw-bold">Chat with Buyers</h5>
                <p class="text-muted">Communicate easily between buyer and seller.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card shadow-sm">
                <div class="feature-icon">✔</div>
                <h5 class="fw-bold">Safe Marketplace</h5>
                <p class="text-muted">Admin approval ensures trusted listings.</p>
            </div>
        </div>

    </div>

</div>