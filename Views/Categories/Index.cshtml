@model IEnumerable<CampusConnect.Models.Category>

@inject CampusConnect.Data.ApplicationDbContext _context

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .category-card {
        background: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        transition: 0.3s;
        text-align: center;
    }

        .category-card:hover {
            transform: translateY(-5px);
        }

    .category-title {
        font-size: 18px;
        font-weight: 600;
    }

    .category-count {
        font-size: 14px;
        color: #6b7280;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .empty-box {
        text-align: center;
        margin-top: 50px;
        color: gray;
    }
</style>

<div class="container-fluid mt-4">

    <!-- HEADER -->
    <div class="top-bar">
        <h2 class="fw-bold">📂 Category Management</h2>

        <a asp-action="Create" class="btn btn-primary">
            ➕ Add Category
        </a>
    </div>

    <div class="row g-4">

        @if (!Model.Any())
        {
            <div class="empty-box">
                <h4>No categories found</h4>
                <p>Add your first category 🚀</p>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                var productCount = _context.Products
                    .Count(p => p.CategoryId == item.Id);

                <div class="col-md-3">

                    <div class="category-card">

                        <!-- ICON -->
                        <div style="font-size:30px;">📦</div>

                        <!-- NAME -->
                        <div class="category-title mt-2">
                            @item.Name
                        </div>

                        <!-- COUNT -->
                        <div class="category-count mt-1">
                            @productCount Products
                        </div>

                        <!-- ACTIONS -->
                        <div class="mt-3 d-flex justify-content-center">

                            <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm me-2">
                                ✏ Edit
                            </a>

                            <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm">
                                🗑 Delete
                            </a>

                        </div>

                    </div>

                </div>
            }
        }

    </div>

</div>